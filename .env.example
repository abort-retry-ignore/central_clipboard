# This host's Tailscale IPv4 address:  tailscale ip -4
BIND_IP=100.x.y.z
CLIP_PORT=8766

# Devices join with this passphrase (at least 10 characters) from
# http://<hub>:8766/join. Use something you can type on a phone.
CLIP_JOIN_PASSPHRASE=change-me-please

# Optional fixed tokens, one "name:token" each (openssl rand -hex 24).
# Unneeded if every device joins with the passphrase.
#CLIP_TOKENS=phone:CHANGE_ME,laptop1:CHANGE_ME

# Keep the clip across hub restarts. Leave off on flash-backed devices such as
# routers, where it would mean a write on every copy.
CLIP_PERSIST_CLIP=false

# Largest clip accepted, in bytes (default 8 MiB). The hub's memory use scales with it:
# roughly 13 MiB at 2 MiB, 27 MiB at 8 MiB. Lower it on a router; raise it on a server.
#CLIP_MAX_BYTES=8388608
