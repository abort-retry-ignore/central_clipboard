# This host's Tailscale IPv4 address:  tailscale ip -4
BIND_IP=100.x.y.z
CLIP_PORT=8766

# One "name:token" per device. Tokens: openssl rand -hex 24
# Revoke a device by deleting its entry and running `docker compose up -d`.
CLIP_TOKENS=phone:CHANGE_ME,laptop1:CHANGE_ME,laptop2:CHANGE_ME,desktop:CHANGE_ME
