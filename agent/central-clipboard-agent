#!/usr/bin/env python3
"""Central clipboard agent: mirrors the Wayland clipboard to and from the hub.

Needs wl-clipboard. Configure with CLIP_URL (http://100.x.y.z:8766) and CLIP_TOKEN.

Start-up adopts the hub's clip (the hub is the source of truth); after that the
last writer wins. Copies made while the hub is unreachable are pushed on reconnect.
"""
import glob
import hashlib
import json
import os
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request

URL = os.environ.get("CLIP_URL", "").rstrip("/")
TOKEN = os.environ.get("CLIP_TOKEN", "")
SENSITIVE_HINT = "x-kde-passwordManagerHint"  # set by password managers on secrets
TEXT_TYPES = ("text/plain;charset=utf-8", "text/plain", "UTF8_STRING", "STRING", "TEXT")


def log(*args):
    print(*args, file=sys.stderr, flush=True)


def wl_env():
    """Environment for wl-clipboard; finds the compositor socket if the service started before it."""
    env = dict(os.environ)
    runtime = env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    display = env.get("WAYLAND_DISPLAY", "")
    if not display or not os.path.exists(os.path.join(runtime, display)):
        sockets = sorted(p for p in glob.glob(os.path.join(runtime, "wayland-*")) if not p.endswith(".lock"))
        if sockets:
            env["WAYLAND_DISPLAY"] = os.path.basename(sockets[0])
    return env


def read_local():
    """(mime, bytes) of the current clipboard, or None if empty, unsupported or a secret."""
    try:
        r = subprocess.run(["wl-paste", "-l"], env=wl_env(), capture_output=True, timeout=5)
        if r.returncode != 0:
            return None
        types = r.stdout.decode(errors="replace").split()
        if SENSITIVE_HINT in types:
            return None
        want = next((t for t in TEXT_TYPES if t in types), None)
        if want is None:  # images only when there is no text alongside
            want = "image/png" if "image/png" in types else next((t for t in types if t.startswith("image/")), None)
        if want is None:
            return None
        r = subprocess.run(["wl-paste", "-n", "-t", want], env=wl_env(), capture_output=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired) as e:
        log("reading clipboard failed:", e)
        return None
    return (want, r.stdout) if r.returncode == 0 and r.stdout else None


def write_local(mime, data):
    # wl-copy forks to keep serving the selection; don't hold pipes it would inherit
    p = subprocess.Popen(["wl-copy", "--type", mime], stdin=subprocess.PIPE,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=wl_env())
    p.stdin.write(data)
    p.stdin.close()
    p.wait(timeout=15)


def request(method, path, data=None, timeout=15):
    headers = {"X-Token": TOKEN}
    if data is not None:
        headers["Content-Type"] = "application/octet-stream"
    return urllib.request.urlopen(
        urllib.request.Request(URL + path, data=data, method=method, headers=headers), timeout=timeout)


class Agent:
    def __init__(self):
        self.lock = threading.Lock()
        self.me = None          # our device name, as told by the hub
        self.local_sha = None   # sha of the clipboard content we last pushed or applied
        self.dirty = False      # a local copy failed to reach the hub
        self.ready = threading.Event()

    def push_local(self):
        with self.lock:
            clip = read_local()
            if clip is None:
                return
            mime, data = clip
            sha = hashlib.sha256(data).hexdigest()
            if sha == self.local_sha:  # our own wl-copy echoing back, or a repeat
                return
            try:
                request("POST", "/clip", data).close()
            except urllib.error.HTTPError as e:
                log(f"hub rejected {mime} clip ({len(data)} bytes): HTTP {e.code}")
                return
            except (urllib.error.URLError, OSError) as e:
                log("push failed, will retry on reconnect:", e)
                self.dirty = True
                return
            self.local_sha, self.dirty = sha, False
            log(f"pushed {mime}, {len(data)} bytes")

    def apply(self, meta):
        with self.lock:
            if meta["sha"] == self.local_sha:
                return
            try:
                with request("GET", "/clip") as r:
                    mime, data = r.headers.get_content_type(), r.read()
            except (urllib.error.URLError, OSError) as e:
                log("fetching clip failed:", e)
                return
            if not data or not mime.startswith(("text/", "image/")):
                log(f"ignoring {meta['mime']} clip from {meta['source']}")
                return
            self.local_sha = hashlib.sha256(data).hexdigest()  # before writing, so the watcher skips the echo
            try:
                write_local(mime, data)
            except (OSError, subprocess.TimeoutExpired) as e:
                log("writing clipboard failed:", e)
                self.local_sha = None
                return
            log(f"applied {mime}, {len(data)} bytes from {meta['source']}")

    def on_event(self, event, payload):
        if event == "hello":
            self.me = payload["you"]
            if self.dirty:
                self.push_local()  # a copy made while offline is newer than the hub's
            elif payload["clip"]:
                self.apply(payload["clip"])
            self.ready.set()
        elif event == "clip" and payload["source"] != self.me:
            self.apply(payload)

    def stream(self):
        delay = 1
        while True:
            try:
                with request("GET", "/events", timeout=45) as r:  # hub pings every 15 s
                    log("connected to hub")
                    event = payload = None
                    for raw in r:
                        line = raw.decode().rstrip("\r\n")
                        if line.startswith("event: "):
                            event = line[7:]
                        elif line.startswith("data: "):
                            payload = json.loads(line[6:])
                        elif line == "" and event:
                            if event == "hello":
                                delay = 1
                            self.on_event(event, payload)
                            event = payload = None
                log("hub closed the stream")
            except (urllib.error.URLError, OSError, ValueError) as e:
                log("hub connection lost:", e)
            time.sleep(delay)
            delay = min(delay * 2, 30)

    def watch(self):
        self.ready.wait(timeout=10)  # let the hub's clip land first; carry on offline after 10 s
        while True:
            try:
                p = subprocess.Popen(["wl-paste", "--watch", "echo"], stdout=subprocess.PIPE,
                                     stderr=subprocess.DEVNULL, env=wl_env())
                for _ in p.stdout:  # one line per clipboard change
                    self.push_local()
                p.wait()
            except OSError as e:
                log("cannot run wl-paste:", e)
            time.sleep(2)  # no compositor yet, or it restarted


def main():
    if not URL or not TOKEN:
        sys.exit("set CLIP_URL and CLIP_TOKEN")
    agent = Agent()
    threading.Thread(target=agent.watch, daemon=True).start()
    agent.stream()


if __name__ == "__main__":
    main()
